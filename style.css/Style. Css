
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #172033;
}

h1 {
  text-align: center;
  color: #075985;
}

button {
  padding: 12px 20px;
  border: none;
  border-radius: 10px;
  background: #075985;
  color: white;
  font-size: 16px;
}
